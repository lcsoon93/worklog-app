# Collaudo dell'accesso reale (Fase 12): copiare in .env.pilota.local (ignorato da git) e compilare
# con `npm run build:pilota`. Accesso con gli account Supabase (nome utente + PIN); i dati inseriti
# restano sul dispositivo finché la sincronizzazione con il server non sarà implementata.
VITE_AMBIENTE=test
VITE_BACKEND=supabase
VITE_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chiave pubblicabile (anon) del progetto>
VITE_VERSIONE_APP=0.2.0-pilota

# Fase 13: nomi utente con privilegi di amministratore operativo (separati da virgola). Non è un segreto.
VITE_AMMINISTRATORI_OPERATIVI=luca
