  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/pdfmake": "0.2.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "pdfjs-dist": "4.10.38",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
