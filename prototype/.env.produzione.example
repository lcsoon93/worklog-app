# MODELLO per la build di produzione: copiare in .env.production.local sulla macchina/pipeline
# di rilascio (mai versionare il file compilato). Valori da compilare durante la Fase 9 con
# autorizzazione del titolare. L'avvio è bloccato finché la configurazione non è completa.
VITE_AMBIENTE=produzione
VITE_BACKEND=supabase
VITE_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chiave anon del progetto di produzione>
VITE_PUSH_VAPID_PUBLIC_KEY=
VITE_AZIENDA_RAGIONE_SOCIALE=<ragione sociale>
VITE_AZIENDA_INDIRIZZO=<indirizzo completo>
VITE_AZIENDA_PARTITA_IVA=<partita IVA>
VITE_AZIENDA_LOGO_SVG=
VITE_VERSIONE_APP=1.0.0
