# Variabili d'ambiente del gestionale (lette in fase di build da Vite: solo VITE_*).
# Copia in .env.local (ignorato da git) o nel file della modalità di build.
# NON inserire qui segreti: tutto ciò che inizia con VITE_ finisce nel codice scaricato dal browser.
# La chiave service_role di Supabase NON deve MAI comparire in questi file.

# Ambiente: demo | test | produzione
#  - demo/test: server simulato e dati dimostrativi rigenerati sul dispositivo
#  - produzione: nessun dato dimostrativo; richiede VITE_BACKEND=supabase
VITE_AMBIENTE=demo

# Backend: simulato | supabase  (l'integrazione supabase non è ancora implementata: vedi docs/17 §6)
VITE_BACKEND=simulato

# Progetto Supabase (solo con VITE_BACKEND=supabase). La chiave "anon" è pubblica per progetto
# e protetta dalle policy RLS; va comunque gestita come configurazione, non scritta nel codice.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chiave PUBBLICA VAPID per le notifiche push (vuota = solo avvisi con app aperta/in background)
VITE_PUSH_VAPID_PUBLIC_KEY=

# Dati aziendali stampati sui documenti (vuoti = valori dimostrativi)
VITE_AZIENDA_RAGIONE_SOCIALE=
VITE_AZIENDA_INDIRIZZO=
VITE_AZIENDA_PARTITA_IVA=
# Testo SVG completo del logo (facoltativo)
VITE_AZIENDA_LOGO_SVG=

# Versione mostrata nell'app (impostata dalla pipeline di rilascio)
VITE_VERSIONE_APP=0.1.0
