# Intestazioni per hosting statico (Netlify / Cloudflare Pages; ignorato da GitHub Pages).
# Il Service Worker e il manifest non vanno mai messi in cache a lungo: così gli aggiornamenti arrivano.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
